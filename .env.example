# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# values. Every value below is read server-side only -- none of these are
# exposed to the browser bundle, because the modules that read them are
# imported exclusively from route handlers and server components.

# --- database -------------------------------------------------------------
# PGlite embeds a real PostgreSQL 16.4 engine and persists to this directory.
# There is no connection string because there is no server: the database is a
# directory. Changing this path gives you an independent database.
PGLITE_DATA_DIR=.pglite

# Connection string for the networked PostgreSQL server. Set it and the app
# uses the Prisma data layer against that server; leave it unset and the app
# falls back to PGlite. The vitest suite always uses PGlite, regardless of this
# value, so tests stay hermetic.
#
#   DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/<database>
DATABASE_URL=

# --- auth -----------------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -base64 32
# The application refuses to start in production if this is unset or is the
# example value, so an accidental deploy cannot run with a public secret.
SESSION_SECRET=dev-only-insecure-secret-change-me

# Seeded demo accounts, so the prototype has someone to sign in as. Passwords
# are hashes, never plaintext. Rotate before any shared deployment.
SEED_DEMO_PASSWORD=portfolio-demo-password

# --- prototype payment provider -------------------------------------------
# Stands in for a real PSP. No network calls are made; the provider reference
# is derived deterministically from the payment row so a given payment always
# reports the same provider id, which is what makes the idempotency tests
# meaningful.
PAYMENT_PROVIDER_NAME=stubpay
